#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/modifiers.h>   /* MOD_MASK_SHIFT 用 */
#include "locale/keys_jp.h"              /* 日本語OS向け JP_* エイリアス */

/* ---------- レイヤーID ---------- */
#define BASE   0
#define LOWER  1
#define RAISE  2
#define MOD    3

/* ---------- タップ系調整 ---------- */
&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <225>;
    quick-tap-ms = <200>;
    require-prior-idle-ms = <150>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <175>;
    quick-tap-ms = <200>;
};

/* ---------- ルート ---------- */
 /{
    behaviors {
        soff: soft_off {
            compatible = "zmk,behavior-soft-off";
            #binding-cells = <0>;
            hold-time-ms = <3000>;
        };

        /* ── US挙動のための mod-morph 群（Shift押下で右側に切替）── */
        two_to_at: mm_two_to_at {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp JP_AT>;
            mods = <MOD_MASK_SHIFT>;
        };

        six_to_caret: mm_six_to_caret {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&kp JP_CARET>;
            mods = <MOD_MASK_SHIFT>;
        };

        seven_to_amp: mm_seven_to_amp {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp JP_AMPERSAND>;
            mods = <MOD_MASK_SHIFT>;
        };

        eight_to_asterisk: mm_eight_to_asterisk {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp JP_ASTERISK>;
            mods = <MOD_MASK_SHIFT>;
        };

        nine_to_lparen: mm_nine_to_lparen {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp JP_LPAREN>;
            mods = <MOD_MASK_SHIFT>;
        };

        zero_to_rparen: mm_zero_to_rparen {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp JP_RPAREN>;
            mods = <MOD_MASK_SHIFT>;
        };

        minus_to_underscore: mm_minus_to_underscore {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_MINUS>, <&kp JP_UNDS>;
            mods = <MOD_MASK_SHIFT>;
        };

        equal_to_plus: mm_equal_to_plus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_EQUAL>, <&kp JP_PLUS>;
            mods = <MOD_MASK_SHIFT>;
        };

        bslash_to_pipe: mm_bslash_to_pipe {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_BSLH>, <&kp JP_PIPE>;
            mods = <MOD_MASK_SHIFT>;
        };

        grave_to_tilde: mm_grave_to_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_GRAVE>, <&kp JP_TILDE>;
            mods = <MOD_MASK_SHIFT>;
        };

        sqt_to_dqt: mm_sqt_to_dqt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_SQT>, <&kp JP_DQT>;
            mods = <MOD_MASK_SHIFT>;
        };

        semi_to_colon: mm_semi_to_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_SEMI>, <&kp JP_COLON>;
            mods = <MOD_MASK_SHIFT>;
        };

        lbkt_to_lbrc: mm_lbkt_to_lbrc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_LBKT>, <&kp JP_LBRC>;
            mods = <MOD_MASK_SHIFT>;
        };

        rbkt_to_rbrc: mm_rbkt_to_rbrc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_RBKT>, <&kp JP_RBRC>;
            mods = <MOD_MASK_SHIFT>;
        };

        slash_to_quest: mm_slash_to_quest {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_SLASH>, <&kp JP_QUEST>;
            mods = <MOD_MASK_SHIFT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* Q+W → Esc（元どおり） */
        Combo1 {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <0>;
        };

        /* I+O → [（Shift同時なら {） */
        Combo2 {
            bindings = <&lbkt_to_lbrc>;
            key-positions = <8 7>;
            layers = <0>;
        };

        /* O+P → ]（Shift同時なら }） */
        Combo3 {
            bindings = <&rbkt_to_rbrc>;
            key-positions = <8 9>;
            layers = <0>;
        };

        /* K+L → ;（Shift同時なら :） */
        Combo4 {
            bindings = <&semi_to_colon>;
            key-positions = <18 19>;
            layers = <0>;
        };

        /* Space+Backspace → MOD */
        Combo5 {
            bindings = <&mo MOD>;
            key-positions = <30 31>;
            layers = <0>;
        };

        /* 親指列 N0+N3 → -（Shift同時なら _） */
        Combo6 {
            bindings = <&minus_to_underscore>;
            key-positions = <25 31>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ---------- BASE ---------- */
        default_layer {
            bindings = <
&kp Q         &kp W       &kp E       &kp R   &kp T           &kp Y               &kp U  &kp I           &kp O          &kp P
&mt LCTRL A   &kp S       &kp D       &kp F   &kp G           &kp H               &kp J  &kp K           &kp L          &kp ENTER
&mt LSHIFT Z  &mt LGUI X  &mt LALT C  &kp V   &kp B           &kp N               &kp M  &mt RALT COMMA  &mt RCTRL DOT  &mt RSHIFT &slash_to_quest
                                              &lt LOWER SPACE   &lt RAISE BACKSPACE
            >;
        };

        /* ---------- LOWER ---------- */
        lower_layer {
            display-name = "LOWER";
            bindings = <
&kp C_VOL_DN  &kp HOME  &kp UP      &kp PG_UP  &kp C_VOLUME_UP  &kp KP_N7   &kp KP_N8  &kp KP_N9  &kp KP_SLASH  &kp KP_MULTIPLY
&trans        &kp LEFT  &kp DOWN    &kp RIGHT  &kp C_MUTE       &kp KP_N4   &kp KP_N5  &kp KP_N6  &kp KP_MINUS  &kp KP_PLUS
&trans        &kp END   &kp INSERT  &kp PG_DN  &kp KP_N0        &kp KP_N1   &kp KP_N2  &kp KP_N3  &kp KP_DOT    &kp KP_EQUAL
                                               &trans           &kp DELETE
            >;
        };

        /* ---------- RAISE ---------- */
        raise_layer {
            display-name = "RAISE";
            bindings = <
/* 数字段：Shift側もUSの意味に統一 */
&kp N1     &two_to_at     &kp N3         &kp N4        &kp N5    &six_to_caret  &seven_to_amp  &eight_to_asterisk  &nine_to_lparen  &zero_to_rparen
/* 右端：'（Shiftで "） */
&kp F1     &kp F2         &kp F3         &kp F4        &kp F5    &kp F6         &kp F7         &kp F8              &kp F9           &sqt_to_dqt
/* 記号列：-/_、=/+、\ /|、` /~ をUS挙動に */
&trans     &minus_to_underscore  &equal_to_plus  &bslash_to_pipe  &grave_to_tilde  &kp CAPS  &kp F10  &kp F11  &kp F12  &kp RSHIFT
                                                &kp TAB    &trans
            >;
        };

        /* ---------- MOD ---------- */
        mod_layer {
            display-name = "MOD";
            bindings = <
&none           &out OUT_USB  &none        &none  &none  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_PRV
&none           &out OUT_BLE  &none        &none  &none  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_CLR
&studio_unlock  &soft_off     &bootloader  &none  &none  &none          &none          &none          &none          &bt BT_NXT
                                                  &none  &none
            >;
        };
    };
};

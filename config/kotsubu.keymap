#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/modifiers.h>   /* ★ Shift検知用（mod-morph に必要） */

/* ★日本語OSでもUSの記号が出るロケール定義（zmk-locales の JP 用） */
#include "locale/keys_jp.h"

#define BASE   0
#define LOWER  1
#define RISE   2
#define MOD    3

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <225>;
    quick-tap-ms = <200>;
    require-prior-idle-ms = <150>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <175>;
    quick-tap-ms = <200>;
};

 /{
    behaviors {
        soff: soft_off {
            compatible = "zmk,behavior-soft-off";
            #binding-cells = <0>;
            hold-time-ms = <3000>;
        };

        /* ★ Shift+2 を常に @ にする（OS=日本語でもUSの挙動） */
        two_to_at: mod_morph_two_at {
            compatible = "zmk,behavior-mod-morph";
            label = "N2->@ when Shift";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp JP_AT>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Combo1 {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <0>;
        };

        /* 角カッコをUS通りに（I+O = [、O+P = ]） */
        Combo2 {
            bindings = <&kp JP_LBKT>;
            key-positions = <8 7>;
            layers = <0>;
        };
        Combo3 {
            bindings = <&kp JP_RBKT>;
            key-positions = <8 9>;
            layers = <0>;
        };

        /* ; をUS通りに */
        Combo4 {
            bindings = <&kp JP_SEMI>;
            key-positions = <18 19>;
            layers = <0>;
        };

        Combo5 {
            bindings = <&mo MOD>;
            key-positions = <30 31>;
            layers = <0>;
        };

        /* - をUS通りに */
        Combo6 {
            bindings = <&kp JP_MINUS>;
            key-positions = <25 31>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q         &kp W       &kp E       &kp R  &kp T            &kp Y               &kp U  &kp I           &kp O          &kp P
&mt LCTRL A   &kp S       &kp D       &kp F  &kp G            &kp H               &kp J  &kp K           &kp L          &kp ENTER
&mt LSHIFT Z  &mt LGUI X  &mt LALT C  &kp V  &kp B            &kp N               &kp M  &mt RALT COMMA  &mt RCTRL DOT  &mt RSHIFT JP_SLASH
                                             &lt LOWER SPACE  &lt RISE BACKSPACE
            >;
        };

        lower_layer {

/* kotsubu.overlay — Studio対応 & deep sleep復帰・完全版
 *
 * ねらい：
 *  - 行列は col2row（列=出力 / 行=入力+PULL_DOWN）
 *  - kscan に wakeup-source を付与
 *  - soft-off 中は「起床用の行」を監視しつつ、
 *    extra-gpios で “列=出力” をアクティブ保持して確実に起床
 *  - Studio要件：chosen には「zmk,physical-layout」と「zmk,kscan」だけ。
 *                 transform/kscan の紐づけは物理レイアウトノード側で行う。
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include "./kotsubu-layouts.dtsi"

/* 不要なら有効化しないでOK（UART占有を避けたい時など） */
&xiao_serial { status = "disabled"; };

/* ---------- SPI ピン設定（74HC595 用） ---------- */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            /* SCK=P1.13, MOSI/MISO=P1.15（XIAO BLEのD8/D9相当） */
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                    <NRF_PSEL(SPIM_MISO, 1, 15)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                    <NRF_PSEL(SPIM_MISO, 1, 15)>;
            low-power-enable;
        };
    };
};

/* ---------- SPI0 と 74HC595 定義 ---------- */
&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";

    /* 595 の /CS を D7 で駆動（アクティブLOW） */
    cs-gpios = <&xiao_d 7 GPIO_ACTIVE_LOW>;

    shift_reg: 595@0 {
        compatible = "zmk,gpio-595";
        status = "okay";
        gpio-controller;
        spi-max-frequency = <200000>;  /* 安定優先で低め */
        reg = <0>;
        #gpio-cells = <2>;
        ngpios = <8>;
    };
};

/* ---------- ルート定義 ---------- */
 /{
    model = "kotsubu";
    compatible = "kotsubu";

    /* Studioのお作法：ここには physical-layout と kscan だけ。 */
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &kotsubu_physical_layout;
    };

    /* --- Matrix Transform（あなたの元マップを踏襲） --- */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <10>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                                        RC(3,4) RC(3,5)
        >;
    };

    /* --- KSCAN（行列スキャン：col2row） --- */
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        /* 必要に応じて2〜3msに上げても安定度UP */
        debounce-press-ms = <1>;
        debounce-release-ms = <5>;

        /* 列：0..7 は 74HC595、8..9 は MCU 直結（D0, D1）
         * 595の物理配線順に合わせ 0 1 2 3 4 7 6 5 の並びを維持
         */
        col-gpios =
            <&shift_reg 0 GPIO_ACTIVE_HIGH>,
            <&shift_reg 1 GPIO_ACTIVE_HIGH>,
            <&shift_reg 2 GPIO_ACTIVE_HIGH>,
            <&shift_reg 3 GPIO_ACTIVE_HIGH>,
            <&shift_reg 4 GPIO_ACTIVE_HIGH>,
            <&shift_reg 7 GPIO_ACTIVE_HIGH>,
            <&shift_reg 6 GPIO_ACTIVE_HIGH>,
            <&shift_reg 5 GPIO_ACTIVE_HIGH>,
            <&xiao_d 0 GPIO_ACTIVE_HIGH>,   /* COL8  MCU直結 */
            <&xiao_d 1 GPIO_ACTIVE_HIGH>;   /* COL9  MCU直結 */

        /* 行：入力 + PULL_DOWN（col2rowの定石） */
        row-gpios =
            <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* ROW0 */
            <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* ROW1 */
            <&xiao_d 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* ROW2 */
            <&xiao_d 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;  /* ROW3 */
    };

    /* --- soft-off 用の起床トリガ構成 ---
     * 1) 起床に使う行を gpio-keys で定義（ここでは ROW0）
     * 2) zmk,gpio-key-wakeup-trigger でその行を監視（wakeup-source）
     * 3) extra-gpios で “列=出力” を起床中 HIGH に保持
     */
    keys {
        compatible = "gpio-keys";

        soft_off_row0: soft_off_row0 {
            gpios = <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; /* ROW0 */
        };
    };

    wakeup_scan: wakeup_scan {
        compatible = "zmk,gpio-key-wakeup-trigger";
        trigger = <&soft_off_row0>;
        wakeup-source;

        /* 起床中だけ、これらの列をアクティブ（HIGH）保持 */
        extra-gpios =
            <&xiao_d 0 GPIO_ACTIVE_HIGH>,   /* COL8: MCU直結 */
            <&xiao_d 1 GPIO_ACTIVE_HIGH>,   /* COL9: MCU直結 */

            /* 必要に応じて 595 側も 1〜2 本だけ足す（安定度UP） */
            <&shift_reg 0 GPIO_ACTIVE_HIGH>, /* 例：COL0 */
            <&shift_reg 4 GPIO_ACTIVE_HIGH>; /* 例：COL4 */
    };

    /* --- soft-off の起床ソース公式ノード --- */
    soft_off_wakers {
        compatible = "zmk,soft-off-wakeup-sources";
        wakeup-sources = <&wakeup_scan>;
    };
};
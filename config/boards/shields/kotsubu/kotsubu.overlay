#include <dt-bindings/zmk/matrix_transform.h>
#include "./kotsubu-layouts.dtsi"

/* UART占有を避けたい時など（XIAO BLEのTX/RXをGPIOで使う場合も必須） */
&xiao_serial { status = "disabled"; };

/* ---------- 74HC595 (SIPO) をGPIOとして扱う ---------- */
&xiao_spi {
/* ---------- 74HC595 (SIPO) をGPIOとして扱う ---------- */
&xiao_spi {
    status = "okay";

    /* 74HC595のRCLK/LATCHピン（ラッチ/CS）をD7に接続 */
    cs-gpios = <&xiao_d 7 GPIO_ACTIVE_LOW>;

    shifter: 595@0 {
        compatible = "zmk,gpio-595";
        status = "okay";
        gpio-controller;
        spi-max-frequency = <200000>;
        reg = <0>;
        #gpio-cells = <2>;
        ngpios = <8>;
    };
};

/* ---------- KSCAN (10 cols x 4 rows) ---------- */

/ {
  kscan0: kscan_0 {
      compatible = "zmk,kscan-gpio-matrix";
      diode-direction = "col2row";
      wakeup-source;

      /* COL0-7: 74HC595、COL8-9: MCU直結 */
      col-gpios
          = <&shifter 0 GPIO_ACTIVE_HIGH>   /* QA -> COL0 */
          , <&shifter 1 GPIO_ACTIVE_HIGH>   /* QB -> COL1 */
          , <&shifter 2 GPIO_ACTIVE_HIGH>   /* QC -> COL2 */
          , <&shifter 3 GPIO_ACTIVE_HIGH>   /* QD -> COL3 */
          , <&shifter 4 GPIO_ACTIVE_HIGH>   /* QE -> COL4 */
          , <&shifter 7 GPIO_ACTIVE_HIGH>   /* QF/QG/QHの配線都合で入れ替え */
          , <&shifter 6 GPIO_ACTIVE_HIGH>
          , <&shifter 5 GPIO_ACTIVE_HIGH>
          , <&xiao_d 0 GPIO_ACTIVE_HIGH>    /* COL8 */
          , <&xiao_d 1 GPIO_ACTIVE_HIGH>    /* COL9 */
          ;

      row-gpios
          = <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* ROW0 */
          , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* ROW1 */
          , <&xiao_d 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* ROW2 */
          , <&xiao_d 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* ROW3 */
          ;
  };

      default_transform: default_transform {
          compatible = "zmk,matrix-transform";
          columns = <10>;
          rows = <4>;
          map = <
              RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
              RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
              RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                                RC(3,4) RC(3,5)
          >;
      };

      /* --- soft-off の起床ソース --- */
      soft_off_wakers {
          compatible = "zmk,soft-off-wakeup-sources";
          wakeup-sources = <&kscan0>;
      };

  chosen {
    zmk,kscan = &kscan0;
    zmk,matrix-transform = &default_transform;
    zmk,matrix_transform = &default_transform;
  };
};
